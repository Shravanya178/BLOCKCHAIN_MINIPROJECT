{
  "name": "certificate-registry-backend",
  "version": "1.0.0",
  "description": "Blockchain-based academic and event certificate generation and verification backend",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "chain": "hardhat node",
    "compile": "hardhat compile && node scripts/export-abi.js",
    "deploy:local": "hardhat run scripts/deploy-contract.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy-contract.js --network sepolia",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "test": "npm run test:contracts && npm run test:api",
    "test:contracts": "hardhat test",
    "test:api": "jest --runInBand"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.29.1",
    "jest": "^29.7.0",
    "pdf-parse": "^1.1.4",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1"
  }
}
