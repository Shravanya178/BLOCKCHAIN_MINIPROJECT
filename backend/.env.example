# =====================================================================
# Certificate Registry Backend - environment template
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
# =====================================================================

# --- Server -----------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public base URL of this API (used to build QR-code verification links).
# For phone scanning on the same Wi-Fi use your LAN IP, e.g. http://192.168.1.20:4000
PUBLIC_BASE_URL=http://localhost:4000
# Optional: override the URL embedded in QR codes (e.g. a frontend page).
# The certificate ID is appended: <VERIFICATION_URL_BASE>/<certificateId>
VERIFICATION_URL_BASE=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database (PostgreSQL / Neon) --------------------------------------
# Pooled connection used by the app at runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Direct (non-pooled) connection used by Prisma migrations
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Auth -------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-string-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# --- Development seed admin (only used by `npm run db:seed`) ------------
SEED_ADMIN_EMAIL=admin@college.edu
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_NAME=System Administrator
# Optional demo teacher account created by the seed script
SEED_TEACHER_EMAIL=teacher@college.edu
SEED_TEACHER_PASSWORD=replace-with-a-strong-password

# --- Blockchain -------------------------------------------------------
# Network label stored with each certificate: hardhat-local | sepolia
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Private key of the wallet that holds ISSUER_ROLE on the contract.
# For the LOCAL Hardhat node you can use Hardhat's publicly known test account #0:
#   0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# NEVER use that key (or commit any real key) for Sepolia/mainnet.
BLOCKCHAIN_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
# Leave empty to read the address from deployments/<BLOCKCHAIN_NETWORK>.json
CONTRACT_ADDRESS=
TX_CONFIRMATIONS=1
TX_TIMEOUT_MS=60000
RPC_TIMEOUT_MS=10000

# --- Sepolia deployment (used by `npm run deploy:sepolia`) ------------
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
DEPLOYER_PRIVATE_KEY=0xYOUR_FUNDED_SEPOLIA_DEPLOYER_KEY
# Optional: extra address to receive ISSUER_ROLE at deployment
ISSUER_ADDRESS=

# --- Storage & limits -------------------------------------------------
STORAGE_DRIVER=local
STORAGE_DIR=./generated/certificates
MAX_CSV_SIZE_BYTES=1048576
MAX_CSV_ROWS=200
MAX_PDF_UPLOAD_BYTES=5242880
INSTITUTION_NAME=Your College of Engineering
