# =====================================================================
# CertiChain Frontend - Environment Configuration Template
# Copy to frontend/.env.local or frontend/.env to customize.
# =====================================================================

# Backend API base URL used by public verification and organizer views.
# Keep local for development; set to the backend HTTPS tunnel URL for a public demo.
VITE_API_URL=http://localhost:4000/api/v1

# Deployed Smart Contract Address (matches backend/deployments/localhost.json or Sepolia)
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Read-only JSON-RPC endpoint used when MetaMask is not connected.
# Use the Sepolia RPC URL for a Sepolia deployment.
VITE_RPC_URL=http://127.0.0.1:8545
